{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "skipLibCheck": true, "allowJs": true,
    "esModuleInterop": true, "isolatedModules": true
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
