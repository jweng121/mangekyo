{
  "name": "mangekyo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @mangekyo/visual-audit-playground dev",
    "build": "pnpm --filter @mangekyo/visual-audit-playground build",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:visual-audit": "node scripts/dev-visual-audit.mjs",
    "dev:demo-erp": "pnpm --filter @mangekyo/demo-erp dev",
    "dev:monitored-agent": "tsx scripts/monitored-agent/runner.ts",
    "demo:reset": "tsx apps/demo-erp/data/reset.ts",
    "demo:seed": "tsx apps/demo-erp/data/reset.ts",
    "demo:test": "vitest run && playwright test"
  },
  "devDependencies": {"@playwright/test":"^1.56.0","playwright":"^1.56.0","tsx":"^4.20.0","vitest":"^3.2.0","typescript":"^5.9.0"}
}
