{
  "name": "mangekyo",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "pnpm --filter @mangekyo/visual-audit-playground dev",
    "build": "pnpm --filter @mangekyo/visual-audit-playground build",
    "typecheck": "tsc --noEmit -p convex/tsconfig.json && tsc --noEmit -p tsconfig.tests.json && pnpm -r --if-present typecheck",
    "dev:finance": "pnpm --filter @mangekyo/finance-dev dev",
    "build:finance": "pnpm --filter @mangekyo/finance-dev build",
    "dev:backend": "convex dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@mangekyo/contracts": "workspace:*",
    "@mangekyo/finance-core": "workspace:*",
    "convex": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "^0.0.65",
    "typescript": "^5.0.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
