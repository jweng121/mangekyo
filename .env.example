# Demo ERP
DEMO_ERP_PORT=3001
DEMO_ERP_BASE_URL=http://localhost:3001
DEMO_ERP_MODE=synthetic
# Agent browser
MANGEKYO_BROWSER=chromium
MANGEKYO_BROWSER_HEADLESS=false
# Capture
MANGEKYO_CAPTURE_SCREENSHOTS=true
MANGEKYO_CAPTURE_DOM=true
# Visual audit
MANGEKYO_AUDIT_URL=http://localhost:3000
# Optional: set to a Phase 1 ingestion endpoint when implemented
# MANGEKYO_INGEST_URL=http://localhost:3000/api/ingest
# Demo state
DEMO_ERP_SEED=42
DEMO_ERP_ALLOW_WRITES=true
# Convex (existing development deployment only). Copy to .env.local at the repository root.
CONVEX_DEPLOYMENT=dev:laudable-sturgeon-5
CONVEX_URL=https://laudable-sturgeon-5.convex.cloud
