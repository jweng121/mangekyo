# Demo ERP
DEMO_ERP_PORT=3001
DEMO_ERP_BASE_URL=http://localhost:3001
DEMO_ERP_MODE=synthetic
# Agent browser
MANGEKYO_BROWSER=chromium
# Capture
MANGEKYO_CAPTURE_SCREENSHOTS=true
MANGEKYO_CAPTURE_DOM=true
# Visual audit
MANGEKYO_AUDIT_URL=http://localhost:3000
# Optional: set to a Phase 1 ingestion endpoint when implemented
# MANGEKYO_INGEST_URL=http://localhost:3000/api/ingest
# Demo state
DEMO_ERP_SEED=42
DEMO_ERP_ALLOW_WRITES=true
# Convex (existing development deployment only). Copy to .env.local at the repository root.
CONVEX_URL=https://laudable-sturgeon-5.convex.cloud

# Local Phase 2 demo. Copy to apps/visual-audit-dev/.env.local if needed.
NEXT_PUBLIC_APP_NAME=Mangekyo
NEXT_PUBLIC_VISUAL_AUDIT_MODE=local
MANGEKYO_DEMO_TENANT_ID=harbor-trust-demo
MANGEKYO_BROWSER_HEADLESS=true
# Optional: absolute directory for JSON records and separate PNG artifacts.
# Default is the OS temp directory / mangekyo-local-demo, outside Next dev's file watcher.
MANGEKYO_LOCAL_DATA_DIR=

# Optional audit model. local is deterministic and requires no credentials.
MANGEKYO_LLM_PROVIDER=local
MANGEKYO_LLM_MODEL=
ANTHROPIC_API_KEY=
# Optional alternative audit provider when MANGEKYO_LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Browser speech is the key-free default. Set fish and FISH_API_KEY for Fish Audio.
MANGEKYO_TTS_PROVIDER=browser
MANGEKYO_TTS_MODEL=
MANGEKYO_TTS_VOICE=
FISH_API_KEY=
# Optional alternative cloud TTS provider.
ELEVENLABS_API_KEY=

# Reserved integration configuration; finance posting is not called by this demo.
MANGEKYO_FINANCE_ADAPTER=mock
MANGEKYO_FINANCE_API_URL=
MANGEKYO_FINANCE_API_KEY=

# Optional Convex adapter: set NEXT_PUBLIC_VISUAL_AUDIT_MODE=convex above.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Server-only OIDC JWT accepted by the configured Convex deployment.
MANGEKYO_CONVEX_AUTH_TOKEN=
# Set these in the Convex deployment, not in the browser.
CONVEX_AUTH_ISSUER=
CONVEX_AUTH_AUDIENCE=
